  "system": {
    "type": "Leviatano",
    "size": "leviathan",
    "traits": "Leviatano a Fioritura Perpetua",
    "description": "<p>Forse il primo leviatano mai abbattuto: un bocciolo che si apre in petali lunghi quasi un chilometro e che, quando muore, ha già un'erede che germoglia. Usala per un leviatano \"di base\" che non dà la caccia, la cui morte diventa un enigma; il vero pericolo sono le rotte interrotte e gli animali impazziti.</p>",
    "sight": [
      {
        "id": "kEgglAf8Om1w5QF8",
        "text": "Frutti e foglie che avvizziscono"
      },
      {
        "id": "gSo4exGKMO6fM3FG",
        "text": "Insetti che cadono morti"
      },
      {
        "id": "8g4SPN3Ztr3hyf8G",
        "text": "Petali immensi che salgono verso le nuvole"
      }
    ],
    "sound": [
      {
        "id": "fBxZ2emTnJyJywBb",
        "text": "La calma dopo la tempesta"
      },
      {
        "id": "4psQ24lty7GAcpCp",
        "text": "Lo scoppiettio del bocciolo che si apre"
      }
    ],
    "smell": [
      {
        "id": "VG7r6lprTqReIdQy",
        "text": "Sempre in contrasto con il luogo: marcio in un bosco rigoglioso, vaniglia e miele su una montagna brulla"
      }
    ]
  },
