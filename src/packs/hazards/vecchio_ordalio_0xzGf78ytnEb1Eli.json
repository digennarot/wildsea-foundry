  "system": {
    "type": "Leviatano",
    "size": "leviathan",
    "traits": "Brutale Bestia Leviatana",
    "description": "<p>Il Re degli Scoiattoli: ogni autunno risale dalle profondità affamato e, troppo vecchio per cacciare, assalta navi mercantili e insediamenti. Usalo per qualcosa che sembra buffo all'inizio e smette presto di esserlo.</p><h3>Ganci e Incontri</h3><ul><li><strong>Consegna Speciale</strong>: La coda squarcia lo scafo: vuole solo le provviste della stiva.</li><li><strong>Un Piano Perfetto</strong>: Dei leviatanieri vogliono legarlo con un guinzaglio lunghissimo e usano la nave come esca.</li><li><strong>Festival Invernale</strong>: La festa d'inverno è interrotta dalle urla: l'equipaggio deve affrontarlo o fuggire senza nave.</li></ul>",
    "sight": [
      {
        "id": "2bTBfeQzKlBZs2a4",
        "text": "Animali in fuga tutti nella stessa direzione"
      },
      {
        "id": "KT4sqzdWdgwGNZDM",
        "text": "Un solco che avanza tra le chiome"
      },
      {
        "id": "IgPKVaru9lTfM3Pa",
        "text": "Pelliccia color fiamma piena di cicatrici e lame spezzate"
      }
    ],
    "sound": [
      {
        "id": "TujFXsyvZiSVoZ2X",
        "text": "Rami che si spezzano"
      },
      {
        "id": "7gLKS5ZDVe7mkGew",
        "text": "Un cinguettio gutturale come un motore"
      }
    ],
    "smell": [
      {
        "id": "1LZ4KiamLuWjbcua",
        "text": "Muschio, sangue e crezzerin puro"
      }
    ],
    "taste": [
      {
        "id": "xBfGbjDJfL9IhKAX",
        "text": "Vecchie ferite e marinai perduti"
      }
    ]
