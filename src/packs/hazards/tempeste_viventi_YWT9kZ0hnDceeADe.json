  "system": {
    "type": "Leviatano",
    "size": "leviathan",
    "traits": "La forza Leviatanica della Natura",
    "description": "<p>Tempeste di dimensioni leviataniche con una coscienza di pura elettricità: alcune venerate, altre evitate a ogni costo. Seguono il vento finché non scelgono un bersaglio, poi lo inseguono fino in fondo. Usale per una minaccia annunciata da lontano, quasi inarrestabile con mezzi normali.</p><h3>Ganci e Incontri</h3><ul><li><strong>Inseguitori di Tempeste</strong>: Un passeggero paga una fortuna per entrare in una tempesta vivente.</li><li><strong>Ladri di Tempeste</strong>: Qualcuno a bordo ha rubato qualcosa a una tempesta, che ora lo insegue.</li></ul>",
    "sight": [
      {
        "id": "9fULBYTlKJyqIc4e",
        "text": "Un'oscurità che cresce all'orizzonte"
      },
      {
        "id": "xdCSZgBkBXNs5I0X",
        "text": "Lampi lontani"
      },
      {
        "id": "dFTmu7XUb9kfmtNX",
        "text": "Portuali che rinforzano i tetti"
      }
    ],
    "sound": [
      {
        "id": "K8BPtvDpQs3c6686",
        "text": "Tuoni che rimbombano"
      },
      {
        "id": "gYFqn7ilAZEDYObq",
        "text": "Pioggia, o qualcosa di simile, che tamburella"
      }
    ],
    "smell": [
      {
        "id": "ZdleGrhrfaFkemvU",
        "text": "Petricore; metallo bruciato se un fulmine cade vicino"
      }
    ]
  },
