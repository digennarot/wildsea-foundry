<div id="ratings" class="flex0">
  <h2 class="corners dark">
    {{localize "wildsea.ratings"}}
    <a class="headerAction navalAttack" data-tooltip="{{localize "wildsea.NAVAL.attack"}}">
      <i class="fas fa-crosshairs"></i>
    </a>
  </h2>
  <div class="flexcol spaced">
    {{#each config.shipRatings as |rating|}}
      {{> "systems/wildsea/templates/sheets/ship/rating.hbs" rating=rating track=(byKey @root.system.ratings rating)}}
    {{/each}}
  </div>
</div>
