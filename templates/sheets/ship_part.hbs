<form class="wildsea">
  <div class="flexcol spaced">
    <div id="header" class="flexrow spaced">
      <div class="flexrow spaced">
        <div class="flex0 img"><img src="{{item.img}}" data-edit="img" title="{{item.name}}" /></div>
        <div class="flexcol spaced">
          <input id="name" class="corners" type="text" name="name" value="{{item.name}}" placeholder="{{localize "wildsea.name"}}" />
          {{> "systems/wildsea/templates/shared/number_field.hbs" field="system.track.max" value=system.track.max label="wildsea.track" min=0 max=8}}
        </div>
      </div>
    </div>

    <div class="flexrow spaced">
      {{#each damageLists as |list|}}
        <div class="form-group stacked">
          <label>{{localize (concat "wildsea.NAVAL." list.key)}}</label>
          <select name="system.{{list.key}}" class="corners damage-list" multiple>
            {{selectOptions @root.damageTypes selected=list.selected localize=true}}
          </select>
        </div>
      {{/each}}
    </div>
    <p class="hint">{{localize "wildsea.NAVAL.partHint"}}</p>

    <div id="body">
      <h3 class="corners mid">{{localize "wildsea.details"}}</h3>
      {{> "systems/wildsea/templates/shared/description.hbs" content=system.enrichedDetails target="system.details"}}
    </div>
  </div>
</form>
